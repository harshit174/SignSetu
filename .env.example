# PostgreSQL server (the notebook creates the database and tables if they do not exist)
PGHOST=127.0.0.1
# PostgreSQL port (default 5432)
PGPORT=5432
# PostgreSQL role used by the notebook and the app (needs CREATEDB for first-run bootstrap)
PGUSER=signsetu
# Password of that role
PGPASSWORD=change-me
# Database name (created automatically)
PGDATABASE=signsetu
# Folder containing dataset_consolidated.h5, manifest_consolidated.csv, quality_flags.csv (Zenodo record 23004815)
DATASET_ROOT=/path/to/Vaksetu_ISL_Dataset
